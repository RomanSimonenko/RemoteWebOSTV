# Example only; provide your persistent absolute data-directory path.
REMOTE_WEBOS_DATA_DIR=/var/lib/remote-webos-tv
REMOTE_WEBOS_HOST=127.0.0.1
REMOTE_WEBOS_PORT=8080
REMOTE_WEBOS_PUBLIC_ORIGIN=http://127.0.0.1:8080
REMOTE_WEBOS_SECURE_COOKIES=false
REMOTE_WEBOS_TRUSTED_PROXY=
# Total recovery deadline in milliseconds, including attempts and cooldowns.
# Integer 1000..300000; applies to WOL, manual reconnect and automatic recovery.
REMOTE_WEBOS_RECOVERY_TIMEOUT_MS=60000
