{
  "name": "@remote-webos-tv/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prestart": "pnpm --filter '@remote-webos-tv/api^...' build",
    "start": "node dist/src/index.js",
    "setup-token": "node dist/src/auth/cli.js setup-token"
  },
  "dependencies": {
    "@remote-webos-tv/contracts": "workspace:*",
    "@remote-webos-tv/tizen": "workspace:*",
    "@remote-webos-tv/tv-adapter": "workspace:*",
    "@remote-webos-tv/web": "workspace:*",
    "@remote-webos-tv/webos": "workspace:*",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "8.3.0",
    "better-sqlite3": "12.11.1",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0"
  }
}
